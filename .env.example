# Required configuration
NTFY_TOPIC=your-topic-name                 # The ntfy topic name to push notifications to (REQUIRED)

# Server configuration (optional)
NTFY_URL=https://ntfy.sh                   # Base URL of the ntfy server (default: https://ntfy.sh)
                                          # Include port if needed, e.g., https://your-ntfy-server.com:8443
NTFY_TOKEN=                                # Authentication token for protected topics/servers
                                          # (only ever sent to NTFY_URL's server, never to a per-call url)

# Destination policy (optional): by default every request goes to NTFY_TOPIC on NTFY_URL
NTFY_TOPICS_ALLOWLIST=                     # e.g. alerts,builds,deploys: the agent may use NTFY_TOPIC or one of these
                                          # (and nothing else); wins over NTFY_ALLOW_TOPIC_OVERRIDE
NTFY_ALLOW_TOPIC_OVERRIDE=false            # true lets the agent pass any per-call `topic`
NTFY_ALLOW_URL_OVERRIDE=false              # true lets the agent pass a per-call server `url`