{
  "name": "ntfy-me-mcp",
  "version": "1.4.2",
  "description": "An ntfy MCP server for sending ntfy notifications to your self-hosted ntfy server from AI Agents 📤 (supports secure token auth & more - use with npx or docker!)",
  "keywords": [
    "ntfy",
    "mcp",
    "mcp-server",
    "notifications",
    "modelcontextprotocol",
    "self-hosted",
    "server",
    "LLM",
    "ntfy-me",
    "ntfy-me-mcp",
    "ntfy-mcp",
    "ntfy-server",
    "ntfy-notifications",
    "ntfy-mcp-server",
    "model-context-protocol",
    "push-notifications",
    "typescript",
    "AI-integration",
    "copilot",
    "visual-studio-code",
    "vscode",
    "claude"
  ],
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "ntfy-me-mcp": "build/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "build/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "dotenv": "18.0.5",
    "markdown-it": "15.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "author": "gitmotion",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitmotion/ntfy-me-mcp.git"
  }
}
